# Postgres — system of record (users, roles, leave, attendance)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/champ_hr

# MongoDB — documents, audit/activity log, raw biometric events (future)
MONGO_URL=mongodb://localhost:27017/champ_hr

# Redis — session cache, rate limiting, job queues (future)
REDIS_URL=redis://localhost:6379

# JWT signing secrets — generate distinct random 32+ byte strings for each environment
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

NODE_ENV=development

# Used by `npm run db:seed` to create the one and only super admin account.
# Set real values in Railway before seeding production — no default ships in the
# repo. The person these belong to fills in the rest of their own profile (bank
# details, DOB, designation, etc.) via the app's Profile page after first login.
SUPER_ADMIN_EMAIL=replace-with-the-super-admins-real-email
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_FULL_NAME=replace-with-the-super-admins-full-name

# Public URL this app is actually reached at (adapter-node uses this for its
# same-origin/CSRF check). Must match the browser's address bar exactly —
# set to your Railway public domain in production, e.g. https://champ-hr.up.railway.app
ORIGIN=http://localhost:3000

# EasyTime Pro biometric import. The devices report local wall-clock time with
# no timezone, so the offset is pinned here rather than taken from the server's
# zone (Railway runs UTC). Leave unset for India — defaults to +05:30. Only
# change it if terminals are installed in another zone.
DEVICE_UTC_OFFSET=+05:30
# Import tokens live hashed in attendance_import_tokens. Either generate one
# against the production database:
#   DATABASE_URL="<railway-url>" npm run import-token:generate -- "EasyTime Pro - <site>"
# or set a random value (32+ characters) here; it is registered as a token
# labelled "Railway variable EASYTIME_IMPORT_TOKEN" the first time it is used.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EASYTIME_IMPORT_TOKEN=

# ProHance Web Services API (attendance polling). The poller pulls the
# Comprehensive User Report for "25th of previous month → today" on an
# interval and matches rows to employees by employee code.
# Base URL including the /prohancei prefix, no trailing slash needed:
PROHANCE_BASE_URL=http://replace-with-prohance-host/prohancei
# Credentials — either shape works; user/password wins when both are set.
# (a) Dedicated web-service user issued by the ProHance team (the API guide's
#     documented auth method — sent as standard HTTP Basic):
PROHANCE_WS_USER=
PROHANCE_WS_PASSWORD=
# (b) Opaque base64 key generated in the ProHance admin UI:
Prohance_API_KEY=replace-with-prohance-api-key
# NOTE: ProHance also whitelists caller IPs — this server's egress IP must be
# authorized on their side or every call fails with 401 "Invalid credentials".
# Poll interval in minutes (default 30, minimum 5, 0 disables the poller):
PROHANCE_POLL_MINUTES=30
# Zone offset ProHance report timestamps are expressed in (default +05:30):
PROHANCE_UTC_OFFSET=+05:30

# Resend transactional email — sends new employees their portal credentials
# when an account is created (master tracker import or a single manual add).
# Unset disables sending: accounts are still created, and the Team screen warns
# that the logins must be passed on by hand.
RESEND_API_KEY=replace-with-resend-api-key
# Signing secret for inbound Resend delivery/bounce webhooks.
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret
# Sender address. MUST be on a domain verified in the Resend account or every
# send fails with "domain is not verified" — the verified domain is
# offer.championsmail.com, which is deliberately not the portal's own domain.
RESEND_FROM="Champ HR <no-reply@offer.championsmail.com>"
# Public portal URL the credentials email links to. Distinct from ORIGIN so
# staging mail can still point people at the address they actually use.
PORTAL_URL=https://champ-hr.com
# Zoom — Champ Hub meeting minutes. One internal Server-to-Server OAuth app on
# the company Zoom account (Zoom App Marketplace › Develop › Build App).
# Unset = Meetings still works from pasted notes; nothing is fetched from Zoom.
# From the app's "App Credentials" page:
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# From the app's "Feature" page, Secret Token (signs every webhook):
ZOOM_WEBHOOK_SECRET=
# Event notification endpoint to enter in the app: https://<portal>/api/zoom/webhook
