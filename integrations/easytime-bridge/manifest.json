{
	"manifest_version": 3,
	"name": "EasyTime → ESS bridge",
	"version": "1.0.0",
	"description": "Copies biometric punches from EasyTime Pro on the office network into the Champ HR ESS portal.",
	"minimum_chrome_version": "144",
	"permissions": ["storage", "alarms", "background"],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "EasyTime → ESS"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	}
}
